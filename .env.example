DATABASE_URL=postgres://urumi:change-me@127.0.0.1:5432/urumi_gateway
# Generate once with: openssl rand -base64 32
UPSTREAM_CREDENTIAL_ENCRYPTION_KEY=
PORT=3100
# Comma-separated exact hostnames or wildcard suffixes permitted to resolve to
# private Kubernetes addresses (for example: *.svc.cluster.local). Leave empty
# in production unless a specific internal upstream is required.
UPSTREAM_ALLOWED_HOSTS=
# Development-only escape hatch for local private IP services. Never enable in production.
UPSTREAM_DEVELOPMENT_ALLOW_PRIVATE=false
# Optional OpenAI-compatible Chat Completions provider. If incomplete, /api/chat returns chat_unavailable.
CHAT_PROVIDER_BASE_URL=https://api.openai.com/v1
CHAT_PROVIDER_API_KEY=
CHAT_MODEL=
CHAT_TIMEOUT_MS=30000
CHAT_MAX_ITERATIONS=6
# One-time fresh-install provisioning only. Store the raw initial API key in a
# secret manager; the provisioner never prints it and does not replace it.
GATEWAY_INITIAL_ADMIN_USERNAME=
GATEWAY_INITIAL_ADMIN_API_KEY=
GATEWAY_INITIAL_WOOCOMMERCE_URL=
GATEWAY_INITIAL_INVENTORY_URL=
GATEWAY_INITIAL_SUPPORT_URL=
GATEWAY_INITIAL_UPSTREAM_TIMEOUT_MS=10000
