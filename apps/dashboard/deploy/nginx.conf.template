server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }
  location = /readyz { access_log off; default_type text/plain; return 200 "ready\n"; }
  location = /runtime-config.js {
    default_type application/javascript;
    return 200 'window.__URUMI_CONFIG__={apiBaseUrl:"${DASHBOARD_API_BASE_URL}"};';
  }
  location /api/ {
    proxy_pass http://${GATEWAY_SERVICE_HOST}:3100;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location / { try_files $uri $uri/ /index.html; }
}
